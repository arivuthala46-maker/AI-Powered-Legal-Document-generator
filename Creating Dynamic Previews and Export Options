Creating Dynamic Previews and Export Options
Dynamic preview functionality allows users to see changes instantly before exporting the final design. The preview can update automatically whenever the user changes text, colors, font size, or other design properties. Export options allow the user to download the completed design in formats such as PNG, JPEG, or JSON.

Main features:

Live/dynamic preview

Text customization

Background color selection

Font-size control

PNG export

JPEG export

JSON design-data export

Reset option

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dynamic Preview & Export</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f2f2f2;
            margin: 0;
            padding: 30px;
        }

        .container {
            max-width: 900px;
            margin: auto;
            background: white;
            padding: 25px;
            border-radius: 12px;
        }

        h1 {
            text-align: center;
        }

        .controls {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 25px;
        }

        label {
            font-weight: bold;
            display: block;
            margin-bottom: 6px;
        }

        input, button {
            width: 100%;
            padding: 10px;
            border-radius: 6px;
            border: 1px solid #ccc;
        }

        button {
            cursor: pointer;
            background: #222;
            color: white;
            border: none;
        }

        button:hover {
            opacity: 0.85;
        }

        .preview {
            width: 600px;
            max-width: 100%;
            height: 350px;
            margin: 20px auto;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            border-radius: 10px;
            overflow: hidden;
        }

        #previewText {
            font-weight: bold;
        }

        .export-buttons {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
        }

        @media (max-width: 600px) {
            .export-buttons {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <h1>Dynamic Preview & Export</h1>

    <!-- Controls -->
    <div class="controls">

        <div>
            <label for="textInput">Text</label>
            <input
                type="text"
                id="textInput"
                value="Hello World"
            >
        </div>

        <div>
            <label for="fontSize">Font Size</label>
            <input
                type="range"
                id="fontSize"
                min="20"
                max="100"
                value="50"
            >
        </div>

        <div>
            <label for="textColor">Text Color</label>
            <input
                type="color"
                id="textColor"
                value="#ffffff"
            >
        </div>

        <div>
            <label for="backgroundColor">Background</label>
            <input
                type="color"
                id="backgroundColor"
                value="#4f46e5"
            >
        </div>

    </div>

    <!-- Dynamic Preview -->
    <div id="preview" class="preview">
        <span id="previewText">Hello World</span>
    </div>

    <!-- Export Options -->
    <div class="export-buttons">
        <button onclick="exportPNG()">Export PNG</button>
        <button onclick="exportJPEG()">Export JPEG</button>
        <button onclick="exportJSON()">Export JSON</button>
    </div>

    <br>

    <button onclick="resetDesign()">Reset Design</button>

</div>

<script>
    const textInput = document.getElementById("textInput");
    const fontSize = document.getElementById("fontSize");
    const textColor = document.getElementById("textColor");
    const backgroundColor =
        document.getElementById("backgroundColor");

    const preview = document.getElementById("preview");
    const previewText = document.getElementById("previewText");

    // Update preview dynamically
    function updatePreview() {
        previewText.textContent = textInput.value;

        previewText.style.fontSize =
            fontSize.value + "px";

        previewText.style.color =
            textColor.value;

        preview.style.backgroundColor =
            backgroundColor.value;
    }

    textInput.addEventListener("input", updatePreview);
    fontSize.addEventListener("input", updatePreview);
    textColor.addEventListener("input", updatePreview);
    backgroundColor.addEventListener("input", updatePreview);

    // Create canvas from preview data
    function createCanvas() {
        const canvas = document.createElement("canvas");

        canvas.width = 1200;
        canvas.height = 700;

        const ctx = canvas.getContext("2d");

        // Background
        ctx.fillStyle = backgroundColor.value;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // Text
        ctx.fillStyle = textColor.value;
        ctx.font =
            "bold " + (fontSize.value * 2) + "px Arial";

        ctx.textAlign = "center";
        ctx.textBaseline = "middle";

        ctx.fillText(
            textInput.value,
            canvas.width / 2,
            canvas.height / 2
        );

        return canvas;
    }

    // Export PNG
    function exportPNG() {
        const canvas = createCanvas();

        const link = document.createElement("a");
        link.download = "design.png";
        link.href = canvas.toDataURL("image/png");

        link.click();
    }

    // Export JPEG
    function exportJPEG() {
        const canvas = createCanvas();

        const link = document.createElement("a");
        link.download = "design.jpg";
        link.href = canvas.toDataURL("image/jpeg", 0.9);

        link.click();
    }

    // Export JSON
    function exportJSON() {

        const designData = {
            text: textInput.value,
            fontSize: fontSize.value,
            textColor: textColor.value,
            backgroundColor: backgroundColor.value
        };

        const jsonData =
            JSON.stringify(designData, null, 4);

        const blob = new Blob(
            [jsonData],
            { type: "application/json" }
        );

        const link = document.createElement("a");

        link.download = "design.json";
        link.href = URL.createObjectURL(blob);

        link.click();

        URL.revokeObjectURL(link.href);
    }

    // Reset
    function resetDesign() {

        textInput.value = "Hello World";
        fontSize.value = 50;
        textColor.value = "#ffffff";
        backgroundColor.value = "#4f46e5";

        updatePreview();
    }

    // Initial preview
    updatePreview();
</script>

</body>
</html>
How it works
1. User Input → Dynamic Preview

Text / Color / Font Size
          ↓
   JavaScript Events
          ↓
     Live Preview
When the user changes any control, the input event calls updatePreview() and immediately changes the preview.

2. Export Process

Dynamic Preview
      ↓
   HTML Canvas
      ↓
 ┌────┼─────┐
 ↓    ↓     ↓
PNG  JPEG   JSON
PNG and JPEG contain the rendered visual design, while JSON stores the editable design properties so they can be loaded again later.

3. Technologies Used

HTML – User interface and preview structure

CSS – Layout and responsive styling

JavaScript – Dynamic preview and export functionality

Canvas API – Image generation

Blob API – JSON file creation and download
